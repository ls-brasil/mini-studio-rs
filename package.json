{
  "name": "mini-studio-rs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo tauri dev",
    "build": "cargo tauri build --no-bundle",
    "build:debug": "cargo build --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:js && npm run check:rust",
    "check:js": "node --check src/main.js && node --check src/studio.js",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "npm run test:ui && npm run test:rust",
    "test:ui": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:capture": "cargo test --manifest-path src-tauri/Cargo.toml captures_a_real -- --ignored --nocapture",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
