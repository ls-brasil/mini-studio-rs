{
  "name": "mini-studio-rs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run",
    "build": "cargo build --release",
    "build:debug": "cargo build",
    "build:vcam": "powershell -NoProfile -File scripts/build-vcam.ps1",
    "release": "powershell -NoProfile -File scripts/release.ps1",
    "check": "cargo check",
    "test": "cargo test",
    "test:capture": "cargo test benchmark_real_monitor_stream -- --ignored --nocapture",
    "benchmark": "cargo run --release --",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt -- --check"
  },
  "version": "0.0.1"
}
